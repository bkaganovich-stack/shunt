[Unit]
Description=xray-gateway out-of-band management Wi-Fi AP (rescue channel)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/bash /opt/xray-proxy/scripts/mgmt_ap.sh up
ExecStop=/usr/bin/bash /opt/xray-proxy/scripts/mgmt_ap.sh down
User=root

[Install]
WantedBy=multi-user.target
