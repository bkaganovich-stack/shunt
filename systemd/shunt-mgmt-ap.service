[Unit]
Description=Shunt — out-of-band management Wi-Fi AP (rescue channel)
After=network-online.target
Wants=network-online.target
# Generated when the rescue AP is configured; without it mgmt_ap.sh
# exits with an error, which is not a fault worth reporting.
ConditionPathExists=/opt/shunt/config/mgmt-ap-hostapd.conf

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/bash /opt/shunt/scripts/mgmt_ap.sh up
ExecStop=/usr/bin/bash /opt/shunt/scripts/mgmt_ap.sh down
User=root

[Install]
WantedBy=multi-user.target
