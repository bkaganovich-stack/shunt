[Unit]
Description=xray-gateway continuous health monitor and auto-fix
After=network-online.target xray-proxy.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/xray-proxy/scripts/health_monitor.py
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
