[Unit]
Description=FPTN second egress (isolated netns + SOCKS bridge on 192.168.244.2:1082)
After=network-online.target xray-proxy.service
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/opt/xray-proxy/scripts/fptn-egress.sh setup
ExecStart=/opt/xray-proxy/scripts/fptn-egress.sh run
ExecStopPost=/opt/xray-proxy/scripts/fptn-egress.sh teardown
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
