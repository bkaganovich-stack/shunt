[Unit]
Description=Shunt — web management interface
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/shunt/web
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 80 --log-level warning --timeout-graceful-shutdown 10
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
