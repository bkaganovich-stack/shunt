[Unit]
Description=DoH proxy: dnsmasq upstream -> DoH 1.1.1.1 over the VPN tunnel (plain :53 is blocked by the VPN server)
After=network.target sing-box.service xray-proxy.service
[Service]
ExecStart=/usr/bin/python3 /opt/xray-proxy/doh_proxy.py
Restart=always
RestartSec=2
User=root
[Install]
WantedBy=multi-user.target
