[Unit]
Description=Shunt — FPTN second egress (isolated netns + SOCKS bridge on 192.168.244.2:1082)
After=network-online.target shunt.service
Wants=network-online.target
# fptn-client is a Suggests, not a dependency: the backup egress is
# optional, and Restart=always would otherwise loop forever without it.
ConditionPathExists=/usr/bin/fptn-client-cli
ConditionPathExists=/etc/fptn-client/token

[Service]
Type=simple
ExecStartPre=/opt/shunt/scripts/fptn-egress.sh setup
ExecStart=/opt/shunt/scripts/fptn-egress.sh run
ExecStopPost=/opt/shunt/scripts/fptn-egress.sh teardown
Restart=always
# Each failed start builds and tears down veth-fptn, and the AdGuard client
# reconnects on every link change it sees. With a dead FPTN server that was a
# flap every 45 s under the primary tunnel (Sep 25). Back off to one attempt
# per 10 minutes; a manual restart (server change, toggle) starts over at 10 s.
RestartSec=10
RestartSteps=6
RestartMaxDelaySec=600

[Install]
WantedBy=multi-user.target
