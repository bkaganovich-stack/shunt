#!/bin/bash
# Сторож: если после включения разгрузок появились зависания передачи или ошибки
# контрольных сумм — снять разгрузки и запретить их до ручного разбора.
set -u
CONF=/opt/shunt/config/network.conf
[ -r "$CONF" ] && . "$CONF"
IF="${WAN_IF:-${LAN_IF:-}}"
[ -n "$IF" ] || exit 0
[ -e "/sys/class/net/$IF/phy80211" ] && exit 0
[ -f /run/shunt-offload-disabled ] && exit 0

n=$(journalctl -k --no-pager -b 2>/dev/null | grep -c -e "NETDEV WATCHDOG" -e "hw csum failure" || true)
[ "${n:-0}" -eq 0 ] && exit 0

ethtool -K "$IF" sg off tso off 2>/dev/null
printf '%s: обнаружено %s событий (зависание передачи или ошибка контрольной суммы), разгрузки сняты\n' \
    "$(date -Is)" "$n" > /run/shunt-offload-disabled
logger -t shunt-offload "разгрузки на $IF сняты автоматически: $n событий в журнале ядра"
