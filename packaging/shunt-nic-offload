#!/bin/bash
# Включает scatter-gather и TSO на WAN-порту.
#
# Драйвер r8169 отдаёт эти возможности выключенными для ВСЕХ карт Realtek —
# это осторожное умолчание ядра из-за старых сообщений о зависаниях передачи,
# а не свойство конкретного экземпляра. На этом железе (RTL8168g, XID 4c0)
# замер 2026-09-06 показал: под нагрузкой 315 Мбит/с отдачи ни одного зависания,
# передача дешевеет примерно на 0,65 ядра на гигабит.
#
# Парный сторож shunt-offload-watch снимет их обратно, если зависания всё же
# появятся.
set -u
CONF=/opt/shunt/config/network.conf
[ -r "$CONF" ] && . "$CONF"
IF="${WAN_IF:-${LAN_IF:-}}"
[ -n "$IF" ] || { echo "не удалось определить порт из $CONF" >&2; exit 1; }
[ -e "/sys/class/net/$IF" ] || { echo "порт $IF отсутствует" >&2; exit 1; }
# Разгрузки имеют смысл на проводной карте. Пока юнит стоял на шлюзе руками,
# это подразумевалось; теперь его ставит пакет — в том числе на коробку в петле,
# где WAN_IF пуст и подстановка даёт беспроводной интерфейс. ethtool там просто
# откажет, а юнит будет падать при каждой загрузке и мозолить глаза в журнале.
[ -e "/sys/class/net/$IF/phy80211" ] && { echo "порт $IF беспроводной — разгрузки не трогаем"; exit 0; }
[ -f /run/shunt-offload-disabled ] && { echo "сторож запретил: $(cat /run/shunt-offload-disabled)"; exit 0; }
ethtool -K "$IF" sg on tso on
ethtool -k "$IF" | grep -E "^(scatter-gather|tcp-segmentation-offload|generic-segmentation-offload)"
