#!/bin/sh
set -e
UNITS="shunt.service shunt-web.service shunt-dohproxy.service shunt-health.service
       shunt-agwatch.service shunt-agwatch.timer shunt-mgmt-ap.service
       shunt-first-boot.service shunt-fptn-egress.service shunt-geoupdate.timer"
case "$1" in
  remove)
    for u in $UNITS; do
        systemctl stop "$u" >/dev/null 2>&1 || true
        systemctl disable "$u" >/dev/null 2>&1 || true
    done
    # Stopping shunt already runs "iptables.sh down" via ExecStopPost.
    # This second call covers the case where the service was not running but
    # rules were left behind by a crash; the script is idempotent.
    [ -x /opt/shunt/scripts/iptables.sh ] && \
        /opt/shunt/scripts/iptables.sh down >/dev/null 2>&1 || true
    ;;
esac
exit 0
