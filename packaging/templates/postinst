#!/bin/sh
# postinst — shunt
set -e

BASE=/opt/shunt
OLD=/opt/xray-proxy
UNITS="shunt.service shunt-web.service shunt-dohproxy.service shunt-health.service
       shunt-agwatch.service shunt-agwatch.timer shunt-mgmt-ap.service
       shunt-fptn-egress.service shunt-geoupdate.timer
       shunt-nic-offload.service shunt-offload-watch.service
       shunt-offload-watch.timer fptn-resolv-heal.service"

# Units the package must keep out of the way. Both exist for the same reason:
# Shunt runs the same software itself, differently. hostapd is started by
# shunt-mgmt-ap.service against a generated configuration, and the distribution
# unit would race it for the radio; fptn-client runs inside a network namespace
# under shunt-fptn-egress.service, and the distribution unit would put the
# tunnel on the host instead, where it rewrites the gateway's own resolv.conf.
# Masked on the live gateway since September and recorded nowhere until now --
# a reinstall would have had both of them enabled and fighting.
CONFLICTING="hostapd.service fptn-client.service"

# Units this package used to ship and no longer does. They are disabled and
# removed on every configure, so a box that installed 2.0.0 stops carrying an
# enabled unit whose ExecStart does not exist.
RETIRED="shunt-first-boot.service"

# Old unit -> its replacement. Used both to retire the old units and to bring
# back up exactly what was running before, so that migrating a live gateway
# leaves it running rather than stopped.
MAP="xray-proxy.service:shunt.service
     xray-web.service:shunt-web.service
     xray-dohproxy.service:shunt-dohproxy.service
     xray-health.service:shunt-health.service
     xray-agwatch.service:shunt-agwatch.service
     xray-agwatch.timer:shunt-agwatch.timer
     xray-mgmt-ap.service:shunt-mgmt-ap.service
     fptn-egress.service:shunt-fptn-egress.service
     xray-geoupdate.service:shunt-geoupdate.service
     xray-geoupdate.timer:shunt-geoupdate.timer"

case "$1" in
  configure)

    # ══ 1. Survey ════════════════════════════════════════════════════════════
    # Nothing here touches a running service. Until 2.0 the product was called
    # xray-gateway, lived in /opt/xray-proxy under xray-* units and was
    # installed by copying files rather than by a package.
    MIGRATE=0
    RESUME=""
    if [ -d "$OLD" ] && [ ! -d "$BASE/config" ]; then
        MIGRATE=1
        for pair in $MAP; do
            old=${pair%%:*}; new=${pair#*:}
            if systemctl is-active --quiet "$old" 2>/dev/null; then
                RESUME="$RESUME $new"
            fi
        done
        echo "shunt: migrating the xray-gateway installation in $OLD"
        [ -n "$RESUME" ] && echo "shunt: will bring back up:$RESUME"
    fi

    # ══ 2. Prepare ═══════════════════════════════════════════════════════════
    # Still no service impact: directories, accounts, unit files, enablement.
    if [ "$MIGRATE" = 0 ]; then
        mkdir -p "$BASE/config/snapshots"
        chmod 755 "$BASE/config"
    fi
    mkdir -p "$BASE/logs" "$BASE/bin"
    chmod 755 "$BASE/logs" "$BASE/bin"

    # Session tokens are signed with this. Until now only the pre-package
    # install.sh created it, so a box installed from the package alone fell back
    # to the literal default in main.py -- a value published with the source,
    # which lets anyone mint a valid admin token for any such gateway. Generated
    # once and never regenerated, so existing sessions survive an upgrade.
    if [ ! -s "$BASE/.secret" ]; then
        if [ -s "$OLD/.secret" ]; then
            cp -a "$OLD/.secret" "$BASE/.secret"
        else
            python3 -c 'import secrets; print(secrets.token_hex(32))' > "$BASE/.secret"
        fi
        chown root:root "$BASE/.secret" 2>/dev/null || true
        chmod 600 "$BASE/.secret"
    fi

    # sing-box runs under its own account (sing-box.service has User=).
    if ! getent passwd sing-box >/dev/null 2>&1; then
        adduser --system --group --no-create-home --home /nonexistent \
                --shell /usr/sbin/nologin sing-box >/dev/null 2>&1 || true
    fi

    # An admin-placed copy in /etc shadows the packaged unit in /lib. Only
    # byte-identical copies are removed; an edited one is left and reported.
    shadowed=""
    for u in $UNITS; do
        old="/etc/systemd/system/$u"; new="/lib/systemd/system/$u"
        [ -f "$old" ] && [ -f "$new" ] || continue
        if cmp -s "$old" "$new"; then rm -f "$old"; else shadowed="$shadowed $u"; fi
    done
    if [ -n "$shadowed" ]; then
        echo "shunt: locally modified units in /etc/systemd/system take" >&2
        echo "  precedence over the packaged copies and were left untouched:" >&2
        for u in $shadowed; do echo "    $u" >&2; done
    fi

    # The offload units were hand-placed in /etc before the package carried
    # them, and they point at /usr/local/sbin. They are not "locally modified"
    # in any sense worth preserving -- they are this package's own files,
    # written by hand in the only place available at the time -- so the test is
    # what they execute rather than whether they match byte for byte. An /etc
    # copy naming /usr/local/sbin is the predecessor of the unit now in /lib,
    # and leaving it would shadow the packaged one forever.
    for u in shunt-nic-offload.service shunt-offload-watch.service \
             shunt-offload-watch.timer; do
        old="/etc/systemd/system/$u"
        [ -f "$old" ] || continue
        grep -q '/usr/local/sbin/' "$old" 2>/dev/null || continue
        rm -f "$old"
        echo "shunt: replaced hand-placed $u with the packaged copy"
    done
    # Their executables, likewise -- but only when what the package installed is
    # byte for byte what was there, so an administrator who edited a script in
    # /usr/local/sbin keeps it and is told that it now wins over nothing.
    for b in shunt-nic-offload shunt-offload-watch; do
        [ -f "/usr/local/sbin/$b" ] && [ -f "/usr/sbin/$b" ] || continue
        if cmp -s "/usr/local/sbin/$b" "/usr/sbin/$b"; then
            rm -f "/usr/local/sbin/$b"
        else
            echo "shunt: /usr/local/sbin/$b differs from the packaged" \
                 "/usr/sbin/$b and was left in place; nothing runs it now" >&2
        fi
    done

    # Masked rather than disabled: disabled still starts on request, and the
    # request here would come from a person debugging at 2am who reasonably
    # assumes hostapd.service is how you start hostapd.
    for u in $CONFLICTING; do
        [ -e "/lib/systemd/system/$u" ] || [ -e "/usr/lib/systemd/system/$u" ] || continue
        [ -L "/etc/systemd/system/$u" ] && continue
        [ -f "/etc/systemd/system/$u" ] && continue
        systemctl mask "$u" >/dev/null 2>&1 \
            && echo "shunt: masked $u — Shunt runs it itself, differently"
    done

    if [ "$MIGRATE" = 0 ] && [ ! -f "$BASE/config/network.conf" ]; then
        /usr/sbin/shunt-setup --detect-only || \
            echo "shunt: network detection failed; run shunt-setup by hand" >&2
    fi

    # The old installer wrote these by hand; the package now owns the same
    # settings in /etc/sysctl.d/90-shunt.conf. Retiring them was tied to the
    # migration, which was wrong: the drop-ins outlive the tree they came with,
    # so a gateway whose old directory was deleted before upgrading keeps them.
    # They then quietly win, because sysctl.d applies files in name order and
    # 99- sorts after 90- -- an edit to the packaged conffile would have no
    # effect and nothing would say why. Moved rather than deleted: they are not
    # ours to destroy, and the backup directory is where the migration already
    # puts what it takes away.
    for f in 90-xray-proxy.conf 99-xray-bbr.conf 99-xray-no-ipv6.conf; do
        [ -e "/etc/sysctl.d/$f" ] || continue
        mkdir -p "$BASE/migration-backup/sysctl"
        mv "/etc/sysctl.d/$f" "$BASE/migration-backup/sysctl/$f"
        echo "shunt: retired /etc/sysctl.d/$f (superseded by 90-shunt.conf);" \
             "the old copy is in $BASE/migration-backup/sysctl"
    done

    # The packaged drop-in only takes effect at boot on its own; forwarding and
    # route_localnet are needed before shunt.service is first started, and
    # disabling IPv6 matters immediately (a live IPv6 path bypasses the split
    # routing entirely, which is a leak rather than a degradation).
    sysctl --system >/dev/null 2>&1 || true

    # Units dropped from the package. 2.0.0 shipped shunt-first-boot.service,
    # a leftover of the pre-package install method: it was enabled here, but its
    # ExecStart lived in a source tree the package does not create, so it failed
    # on every boot. First-time setup is done by this script and shunt-setup.
    for u in $RETIRED; do
        systemctl disable "$u" >/dev/null 2>&1 || true
        rm -f "/etc/systemd/system/$u" "/lib/systemd/system/$u"
        # On an upgrade dpkg has already deleted the unit file by the time this
        # runs, and systemctl cannot disable a unit it can no longer read, so
        # the enablement symlink is removed by hand rather than left dangling.
        rm -f /etc/systemd/system/*.wants/"$u" \
              /etc/systemd/system/*.requires/"$u"
    done

    systemctl daemon-reload >/dev/null 2>&1 || true
    # Enabled but not armed: a timer started here would fire while the old
    # services are still running, and one of them wrote its log into a
    # directory the switch below still has to move.
    for u in $UNITS; do
        [ -f "/lib/systemd/system/$u" ] && systemctl enable "$u" >/dev/null 2>&1 || true
    done

    # ══ 3. Switch over ═══════════════════════════════════════════════════════
    # The only part that interrupts anything. Stopping xray-proxy runs its
    # ExecStopPost, which withdraws the TPROXY rules *and* the blanket
    # MASQUERADE — in the inline layout that is the whole network's route to
    # the internet, not merely the tunnel. So this block is kept as short as
    # possible and everything slow was done above.
    if [ "$MIGRATE" = 1 ]; then
        mkdir -p "$BASE/migration-backup/systemd"
        for pair in $MAP; do
            old=${pair%%:*}
            [ -f "/etc/systemd/system/$old" ] && \
                cp -a "/etc/systemd/system/$old" "$BASE/migration-backup/systemd/"
            systemctl stop "$old" >/dev/null 2>&1 || true
            systemctl disable "$old" >/dev/null 2>&1 || true
            rm -f "/etc/systemd/system/$old"
        done
        systemctl daemon-reload >/dev/null 2>&1 || true

        # /opt is one filesystem, so these are renames rather than copies and
        # cost nothing regardless of the hundreds of megabytes involved.
        [ -d "$OLD/config" ] && mv "$OLD/config" "$BASE/config"
        # By content rather than by directory: the destination already exists,
        # and may already hold a file written since the package was unpacked.
        if [ -d "$OLD/logs" ]; then
            mkdir -p "$BASE/logs"
            find "$OLD/logs" -mindepth 1 -maxdepth 1 -exec mv -n {} "$BASE/logs/" \; 2>/dev/null || true
            rmdir "$OLD/logs" 2>/dev/null || true
        fi
        [ -f "$BASE/config/gateway.db" ] && mv "$BASE/config/gateway.db" "$BASE/config/shunt.db"
        # The core normally arrives in shunt-xray. If that package was not part
        # of the same transaction, the old binary is carried over rather than
        # leaving the gateway with no core to run.
        [ -x "$BASE/bin/xray" ] || { [ -x "$OLD/bin/xray" ] && mv "$OLD/bin/xray" "$BASE/bin/xray"; }
        # dnsmasq's snippet is regenerated under the new name; both would apply.
        rm -f /etc/dnsmasq.d/gateway.conf
        mkdir -p "$BASE/config/snapshots"

        for u in $RESUME; do systemctl start "$u" >/dev/null 2>&1 || true; done
        # A unit still coming up is not a unit that failed; give them a moment
        # before passing judgement.
        sleep 3

        failed=""
        for u in $RESUME; do
            systemctl is-active --quiet "$u" 2>/dev/null || failed="$failed $u"
        done
        if [ -n "$failed" ]; then
            echo "shunt: these did not come back up:$failed" >&2
            echo "  The previous unit files are in $BASE/migration-backup/systemd." >&2
            echo "  Check: systemctl status$failed" >&2
        else
            echo "shunt: migration complete; the services that were running are running"
        fi
        echo "shunt: configuration is now in $BASE/config; the old code in $OLD"
        echo "  is unused and can be deleted once you are satisfied."
    fi

    # ══ 4. First install on a fresh machine ══════════════════════════════════
    # Routing services are enabled but deliberately NOT started: they rewrite
    # firewall and routing tables, which must not happen unattended during a
    # package install. A migration is different — there the gateway was already
    # routing, and section 3 put it back the way it was.
    if [ "$MIGRATE" = 0 ] && [ -z "$2" ]; then
        systemctl start shunt-web.service >/dev/null 2>&1 || true
        echo "shunt: web interface on port 80. Routing services are enabled but"
        echo "  not started — review the configuration, then run:"
        echo "    systemctl start shunt sing-box"
    elif [ "$MIGRATE" = 0 ] && [ -n "$2" ]; then
        # Upgrade: restart only what was already running.
        #
        # With one exception. The web interface offers a terminal, and that
        # terminal is a shell inside shunt-web's own cgroup -- so an upgrade
        # started from it is killed the moment this loop restarts shunt-web:
        # systemd takes down the service, and with it the shell, apt and dpkg
        # in the middle of configuring. The package ends up half-configured and
        # the next apt run refuses to do anything until someone runs
        # "dpkg --configure -a" from somewhere else. Restarting a second later,
        # from outside, lets dpkg finish first. The interface still goes away
        # for a moment -- it has to, the new code is only running after it
        # comes back -- but nothing is left broken behind it.
        in_web=0
        grep -qs 'shunt-web\.service' /proc/self/cgroup && in_web=1
        for u in $UNITS; do
            case "$u" in *.timer) continue;; esac
            systemctl is-active --quiet "$u" 2>/dev/null || continue
            if [ "$u" = shunt-web.service ] && [ "$in_web" = 1 ] \
               && command -v systemd-run >/dev/null 2>&1; then
                echo "shunt: this upgrade is running inside the web terminal;" \
                     "the interface restarts a moment after it finishes"
                systemd-run --on-active=5 --unit=shunt-web-restart --collect \
                    systemctl restart shunt-web.service >/dev/null 2>&1 || true
            else
                systemctl restart "$u" >/dev/null 2>&1 || true
            fi
        done
    fi

    # ══ 4b. Arm the timers ═══════════════════════════════════════════════════
    # Last, so that nothing fires while the switch above is in progress.
    for u in $UNITS; do
        case "$u" in *.timer) ;; *) continue;; esac
        [ -f "/lib/systemd/system/$u" ] && systemctl enable --now "$u" >/dev/null 2>&1 || true
    done

    # ══ 5. Rule sets ═════════════════════════════════════════════════════════
    # Required at runtime, too volatile to ship in the package.
    if [ ! -s "$BASE/config/geosite.dat" ] || [ ! -s "$BASE/config/geoip.dat" ]; then
        echo "shunt: downloading geoip/geosite rule sets…"
        "$BASE/scripts/update-geo.sh" || \
            echo "shunt: download failed; run $BASE/scripts/update-geo.sh once online" >&2
    fi
    ;;
esac
exit 0
